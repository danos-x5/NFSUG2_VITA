# Shaders: Cg sources in shaders/, compiled .gxp binaries in shaders/gxp/, embedded as C arrays. Configuring checks
# the binaries against shaders/gxp/sources.txt, which cmake/shader_sources.cmake writes.

get_filename_component(NFSU_SHADER_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../shaders" ABSOLUTE)
if(NOT CMAKE_SCRIPT_MODE_FILE)
  set(NFSU_SHADER_BINARY_DIR "${CMAKE_BINARY_DIR}/shaders")
  file(MAKE_DIRECTORY "${NFSU_SHADER_BINARY_DIR}")
endif()

# The sources.txt line of a compiled program.
function(nfsu_shader_record out_var name gxp source defines)
  if(NOT source)
    set(source "${name}.cg")
  endif()
  file(SHA256 "${gxp}" gxp_hash)
  file(SHA256 "${NFSU_SHADER_SOURCE_DIR}/${source}" source_hash)
  string(REPLACE ";" " " defines "${defines}")
  string(STRIP "${name} ${gxp_hash} ${source_hash} ${source} ${defines}" line)
  set(${out_var} "${line}" PARENT_SCOPE)
endfunction()

# nfsu_add_shader(<list-var> <name> <sce_vp_psp2|sce_fp_psp2> [SOURCE <file.cg>] [DEFINES <NAME=value>...])
# Adds shaders/gxp/<name>.gxp -> <name>_gxp.c (symbols shader_<name>, shader_<name>_size). SOURCE and DEFINES name
# the Cg source and defines the binary was compiled from (SOURCE defaults to <name>.cg).
function(nfsu_add_shader out_var name profile)
  cmake_parse_arguments(SHADER "PENDING" "SOURCE" "DEFINES" ${ARGN})
  if(SHADER_PENDING)
    return()
  endif()
  if(NOT SHADER_SOURCE)
    set(SHADER_SOURCE "${name}.cg")
  endif()
  set(gxp "${CMAKE_SOURCE_DIR}/shaders/gxp/${name}.gxp")
  set(csrc "${NFSU_SHADER_BINARY_DIR}/${name}_gxp.c")
  if(NOT EXISTS "${gxp}")
    message(FATAL_ERROR "Missing shader ${gxp}")
  endif()
  nfsu_shader_record(record ${name} "${gxp}" "${SHADER_SOURCE}" "${SHADER_DEFINES}")
  string(REGEX MATCH "^[^ ]+ [^ ]+" binary "${record}")
  set(recorded "${NFSU_RECORDED_${name}}")
  string(FIND "${recorded} " "${binary} " at)
  if(NOT at EQUAL 0)
    set_property(GLOBAL APPEND PROPERTY NFSU_SHADERS_UNRECORDED ${name})
  elseif(NOT recorded STREQUAL record)
    set_property(GLOBAL APPEND PROPERTY NFSU_SHADERS_STALE ${name})
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${gxp}" "${NFSU_SHADER_SOURCE_DIR}/${SHADER_SOURCE}")
  add_custom_command(
    OUTPUT "${csrc}"
    COMMAND "${CMAKE_COMMAND}" "-DINPUT=${gxp}" "-DOUTPUT=${csrc}" "-DSYMBOL=shader_${name}"
            -P "${CMAKE_SOURCE_DIR}/cmake/bin2c.cmake"
    DEPENDS "${gxp}" "${CMAKE_SOURCE_DIR}/cmake/bin2c.cmake"
    COMMENT "Embedding shader ${name}.gxp"
    VERBATIM)
  list(APPEND ${out_var} "${csrc}")
  set(${out_var} "${${out_var}}" PARENT_SCOPE)
endfunction()

# Every program of the port: the present and clear programs, the Direct3D effect and fixed-function programs
# (include/platform/render.h); fragment programs also with -DATEST (alpha test, suffix _atest), filter programs also
# with -DFACTOR (blend factor outputs, suffixes _bfcolor, _bfalpha, _bfscale).
function(nfsu_add_shaders out_var)
  set(list "")
  set(manifest "${NFSU_SHADER_SOURCE_DIR}/gxp/sources.txt")
  if(EXISTS "${manifest}")
    if(NOT CMAKE_SCRIPT_MODE_FILE)
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
    endif()
    file(STRINGS "${manifest}" records REGEX "^[^#]")
    foreach(record ${records})
      string(REGEX MATCH "^[^ ]+" program "${record}")
      set(NFSU_RECORDED_${program} "${record}")
    endforeach()
  endif()
  set_property(GLOBAL PROPERTY NFSU_SHADERS_UNRECORDED "")
  set_property(GLOBAL PROPERTY NFSU_SHADERS_STALE "")
  nfsu_add_shader(list blit_v  sce_vp_psp2)
  nfsu_add_shader(list blit_f  sce_fp_psp2)
  nfsu_add_shader(list clear_v sce_vp_psp2)
  nfsu_add_shader(list clear_f sce_fp_psp2)
  foreach(name world_v worldheadlight_v worldreflect_v worldheadlightreflect_v car_v filter_v clearz_v)
    nfsu_add_shader(list ${name} sce_vp_psp2)
  endforeach()
  nfsu_add_shader(list worldbone_v sce_vp_psp2)
  nfsu_add_shader(list worldbone_f sce_fp_psp2)
  nfsu_add_shader(list worldbone_f_atest sce_fp_psp2 SOURCE worldbone_f.cg DEFINES ATEST=1)
  foreach(name worldreflect worldheadlight worldheadlightreflect)
    nfsu_add_shader(list ${name}_fog_v sce_vp_psp2 SOURCE ${name}_v.cg DEFINES FOG=1)
    nfsu_add_shader(list ${name}_fog_f sce_fp_psp2 SOURCE ${name}_f.cg DEFINES FOG=1)
    nfsu_add_shader(list ${name}_fog_f_atest sce_fp_psp2 SOURCE ${name}_f.cg DEFINES FOG=1 ATEST=1)
  endforeach()
  nfsu_add_shader(list world_proj_v sce_vp_psp2 SOURCE world_v.cg DEFINES PROJ=1)
  nfsu_add_shader(list ff_v sce_vp_psp2)
  nfsu_add_shader(list ff_screen_v sce_vp_psp2 SOURCE ff_v.cg DEFINES SCREEN=1)
  foreach(name world_f worldheadlight_f worldreflect_f worldheadlightreflect_f car_f)
    nfsu_add_shader(list ${name} sce_fp_psp2)
    nfsu_add_shader(list ${name}_atest sce_fp_psp2 SOURCE ${name}.cg DEFINES ATEST=1)
  endforeach()
  nfsu_add_shader(list world_proj_f sce_fp_psp2 SOURCE world_f.cg DEFINES PROJ=1)
  nfsu_add_shader(list world_proj_f_atest sce_fp_psp2 SOURCE world_f.cg DEFINES PROJ=1 ATEST=1)
  foreach(taps 1 2 3 4)
    nfsu_add_shader(list filter${taps}_f sce_fp_psp2 SOURCE filter_f.cg DEFINES TAPS=${taps})
    nfsu_add_shader(list filter${taps}_f_atest sce_fp_psp2 SOURCE filter_f.cg DEFINES TAPS=${taps} ATEST=1)
    # Blend factor variants (render::FactorOutput 1..3).
    set(factor 1)
    foreach(suffix bfcolor bfalpha bfscale)
      nfsu_add_shader(list filter${taps}_f_${suffix} sce_fp_psp2 SOURCE filter_f.cg DEFINES TAPS=${taps} FACTOR=${factor})
      math(EXPR factor "${factor} + 1")
    endforeach()
  endforeach()
  foreach(variant color tex proj)
    string(TOUPPER ${variant} define)
    set(defines "")
    if(NOT variant STREQUAL "color")
      set(defines ${define}=1)
    endif()
    nfsu_add_shader(list ff_${variant}_f sce_fp_psp2 SOURCE ff_f.cg DEFINES ${defines})
    nfsu_add_shader(list ff_${variant}_f_atest sce_fp_psp2 SOURCE ff_f.cg DEFINES ${defines} ATEST=1)
  endforeach()
  nfsu_add_shader(list skymorph_f sce_fp_psp2)
  nfsu_add_shader(list skymorph_f_atest sce_fp_psp2 SOURCE skymorph_f.cg DEFINES ATEST=1)
  set(effect 1)
  foreach(name overbright_f screengain_f screentint_f screenramp_f raindrop_f)
    nfsu_add_shader(list ${name} sce_fp_psp2 SOURCE screen_f.cg DEFINES EFFECT=${effect})
    nfsu_add_shader(list ${name}_atest sce_fp_psp2 SOURCE screen_f.cg DEFINES EFFECT=${effect} ATEST=1)
    set(factor 1)
    foreach(suffix bfcolor bfalpha bfscale)
      nfsu_add_shader(list ${name}_${suffix} sce_fp_psp2 SOURCE screen_f.cg DEFINES EFFECT=${effect} FACTOR=${factor})
      math(EXPR factor "${factor} + 1")
    endforeach()
    math(EXPR effect "${effect} + 1")
  endforeach()
  get_property(unrecorded GLOBAL PROPERTY NFSU_SHADERS_UNRECORDED)
  get_property(stale GLOBAL PROPERTY NFSU_SHADERS_STALE)
  string(CONCAT recompile "tools/shadercomp/vita_compile.py --out <dir>, cmake -DGXP=<dir> -P "
                          "cmake/shader_sources.cmake, then copy <dir>/*.gxp and <dir>/sources.txt to shaders/gxp/")
  if(unrecorded)
    string(REPLACE ";" " " unrecorded "${unrecorded}")
    message(FATAL_ERROR "shaders/gxp: ${unrecorded}: not the binaries shaders/gxp/sources.txt records. Binaries of "
                        "different compiles can disagree on varyings. Copy one whole compile: ${recompile}.")
  endif()
  if(stale)
    string(REPLACE ";" " " stale "${stale}")
    message(WARNING "shaders/gxp: ${stale}: compiled from older Cg sources; the VPK runs the old programs. "
                    "Recompile: ${recompile}.")
  endif()
  set(${out_var} "${list}" PARENT_SCOPE)
endfunction()
