// UG2's full-screen pixel shaders by EFFECT: 1 overbright, 2-4 screen filter passes 0-2, 5 rain drop. uParam0/1: the
// effect's constants. ATEST and FACTOR as in filter_f.cg.

float4 main(
    float2 vTex0 : TEXCOORD0,
    uniform sampler2D uTex0,
#if EFFECT == 2 || EFFECT == 4 || EFFECT == 5
    uniform sampler2D uTex1,
#endif
#if EFFECT == 2
    uniform sampler2D uTex2,
#endif
    uniform float4 uAlphaTest,
    uniform float4 uParam0,
    uniform float4 uParam1,
    uniform float4 uBlendFactor) : COLOR
{
#if FACTOR == 1
    return uBlendFactor;
#else
#if EFFECT == 1
    float3 bright = saturate((tex2D(uTex0, vTex0).rgb - uParam0.x) * 4.0);
    float grey = clamp(dot(bright, uParam1.rgb), -1.0, 1.0);
    float3 lit = bright * grey;
    float4 c = float4(lit * lit, 0.0);
#elif EFFECT == 2
    float4 s = tex2D(uTex0, vTex0);
    float4 g1 = tex2D(uTex1, float2(dot(s.rgb, float3(0.3, 0.59, 0.11)), s.r));
    float4 g2 = tex2D(uTex2, s.gb);
    float k = saturate(1.0 - g1.a);
    float4 c = float4(float3(g1.r, g2.g, g2.b) * k + s.rgb * (1.0 - k), g1.a * k + g1.r * (1.0 - k));
#elif EFFECT == 3
    float4 s = tex2D(uTex0, vTex0);
    float w = saturate(1.0 - (max(s.r, s.g) - s.b)) * uParam0.x;
    float4 c = float4(s.rgb + w * uParam1.rgb, s.a);
#elif EFFECT == 4
    float4 s = tex2D(uTex0, vTex0);
    float4 r = tex2D(uTex1, s.gb);
    float t = uParam1.a;
    float4 c = float4(s.a * t + float3(s.r, s.g, r.b) * (1.0 - t), t + (1.0 - t) * (1.0 - t));
#elif EFFECT == 5
    float4 d = tex2D(uTex1, vTex0);
    float4 s = tex2D(uTex0, float2(d.g * uParam0.z + uParam0.x, d.b * uParam0.w + uParam0.y));
    float4 c = float4(s.rgb * 1.2, d.a * uParam1.x);
#endif
#ifdef ATEST
    if (uAlphaTest.x * saturate(c.a) < uAlphaTest.y)
        discard;
#endif
#if FACTOR == 2
    return float4(c.rgb, uBlendFactor.a);
#elif FACTOR == 3
    return saturate(c) * uBlendFactor;
#else
    return c;
#endif
#endif
}
