// worldheadlight effect: (headlight * depth fade * headlight colour + colour) * texture * 2. FOG: UG2's, alpha
// texture * colour, depth fade row 0.005, then vertex fog.

float4 main(
    float4 vColor : COLOR0,
    float2 vTex0 : TEXCOORD0,
    float4 vTex1 : TEXCOORD1,
#ifdef FOG
    float vFog : TEXCOORD2,
    uniform float4 uFogColor,
#endif
    uniform sampler2D uTex0,
    uniform sampler2D uTex1,
    uniform sampler2D uTex2,
    uniform float4 uHeadlightColor,
    uniform float4 uAlphaTest) : COLOR
{
    float4 t = tex2D(uTex0, vTex0);
    float4 h = tex2Dproj(uTex1, vTex1.xyz);
#ifdef FOG
    float4 k = tex2D(uTex2, float2(vTex1.w, 0.005));
#else
    float4 k = tex2D(uTex2, float2(vTex1.w, 0.0));
#endif
    float4 c;
#ifdef FOG
    c.rgb = saturate((h.rgb * k.rgb * uHeadlightColor.rgb + vColor.rgb) * t.rgb * 2.0);
    c.a = saturate(t.a * vColor.a);
#else
    c.rgb = (h.rgb * k.rgb * uHeadlightColor.rgb + vColor.rgb) * t.rgb * 2.0;
    c.a = t.a * vColor.a * 2.0;
#endif
#ifdef ATEST
    if (uAlphaTest.x * saturate(c.a) < uAlphaTest.y)
        discard;
#endif
#ifdef FOG
    c.rgb = lerp(uFogColor.rgb, c.rgb, vFog);
#endif
    return c;
}
