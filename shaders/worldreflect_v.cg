// worldreflect effect: world plus the planar reflection texture at the projected position. FOG: UG2's, which adds
// the vertex fog factor.

void main(
    float3 aPosition,
    float4 aColor,
    float2 aTex0,
    uniform float4 uWvp[4],
#ifdef FOG
    uniform float4 uViewZ,
    uniform float4 uFogValue,
#endif
    float4 out vPosition : POSITION,
    float4 out vColor : COLOR0,
    float2 out vTex0 : TEXCOORD0,
#ifdef FOG
    float3 out vTex1 : TEXCOORD1,
    float out vFog : TEXCOORD2)
#else
    float3 out vTex1 : TEXCOORD1)
#endif
{
    float4 p = aPosition.x * uWvp[0] + aPosition.y * uWvp[1] + aPosition.z * uWvp[2] + uWvp[3];
    vPosition = p;
    vColor = aColor.zyxw;
    vTex0 = aTex0;
    vTex1 = float3((p.x + p.w) * 0.5, (p.w - p.y) * 0.5, p.w);
#ifdef FOG
    float z = aPosition.x * uViewZ.x + aPosition.y * uViewZ.y + aPosition.z * uViewZ.z + uViewZ.w;
    vFog = saturate(max((uFogValue.x - z) * uFogValue.y, uFogValue.z));
#endif
}
